      <FactionIcon>Textures\FactionLogo\Empty.dds</FactionIcon>
      <FactionIconWorkshopId>
        <Id>3219757925</Id>
        <ServiceName>Steam</ServiceName>
      </FactionIconWorkshopId>
      <IconColor R="255" G="255" B="255" A="255" />
      <Description>SPCR PMC is an independant contractor providing personal assistant services to local clients.  They Specialize in providing personal transportation, asset retrieval, and heavy metal delivery to all kinds unknowing clients.
      </Description>
    </Faction>

