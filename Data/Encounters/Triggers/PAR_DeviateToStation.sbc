<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>PAR_Trigger_CallForStations</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [UseTrigger:true]
        [Type:Timer]

        [MinCooldownMs:30000]
        [MaxCooldownMs:180000]

        [MaxActions:-1]
        [Actions:PAR_Action_CallForStations]
      </Description>

    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>PAR_Trigger_DeviateToStation</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [DebugMessage:Deviate to station - Received code]

        [UseTrigger:true]
        [Type:CommandReceived]
        [CommandReceiveCode:PAR_DeviateToStation]

        [StartsReady:true]
        [MaxActions:1]
        [Actions:PAR_Action_DeviateToStation]

      </Description>

    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>PAR_Action_DeviateToStation</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]

        [AddWaypointFromCommand:true]
        [UseChatBroadcast:true]
        [ChatData:PAR_Chat_DeviateToStation]

        [ChangeAutopilotMinAltitude:true]
        [NewAutopilotMinAltitude:70]

        [ResetCooldownTimeOfTriggers:true]
        [ResetTriggerCooldownNames:PAR_Trigger_PrepareToArriveAtStation]

        [EnableTriggers:true]
        [EnableTriggerNames:PAR_Trigger_PrepareToArriveAtStation]

        [DisableTriggers:true]
        [DisableTriggerNames:PAR_Trigger_CallForStations]
        [DisableTriggerNames:PAR_Trigger_DeviateToStation]
      </Description>

    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>PAR_Chat_DeviateToStation</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]

        [UseChat:true]
        [StartsReady:true]
        [MaxChats:1]
        [BroadcastRandomly:true]
        [Author:VALK Transport Pilot]
        [Color:Blue]

        [ChatMessages:Re-routing to station. Keep an eye out for any hostiles in the area.]
        [ChatAudio:ArcHudGPSNotification1]
        [BroadcastChatType:Chat]

        [ChatMessages:Outpost upgrade en-route. Hold position and await further instructions.]
        [ChatAudio:ArcHudGPSNotification1]
        [BroadcastChatType:Chat]

        [ChatMessages:Proceeding to station. Adjusting course as necessary.]
        [ChatAudio:ArcHudGPSNotification1]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>