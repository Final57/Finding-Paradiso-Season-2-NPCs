<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Manipulation</SubtypeId>
            </Id>
            <Description>
                [MES Manipulation]

                [UseRandomNameGenerator:true]
                [RandomGridNamePrefix:(NPC-VALK)]
                [RenameGrid:true]

                [ClearAuthorship:true]
            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Manipulation_Fighter</SubtypeId>
            </Id>
            <Description>
                [MES Manipulation]

                [UseLootProfiles:true]
                [LootProfiles:PAR_VALK_LootProfile_Fighter]
            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Manipulation_Outpost</SubtypeId>
            </Id>
            <Description>
                [MES Manipulation]

                [UseLootProfiles:true]
                [LootProfiles:PAR_VALK_LootProfile_Outpost]
            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Manipulation_AtmoGunship</SubtypeId>
            </Id>
            <Description>
                [MES Manipulation]

                [UseLootProfiles:true]
                [LootProfiles:PAR_VALK_LootProfile_Fighter]
            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Manipulation_Freighter</SubtypeId>
            </Id>
            <Description>
                [MES Manipulation]

                [UseLootProfiles:true]
                [LootProfiles:PAR_VALK_LootProfile_Freighter]
            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Manipulation_Hydrogen</SubtypeId>
            </Id>
            <Description>
                [MES Manipulation]

                [UseBlockReplacerProfile:true]
                [BlockReplacerProfileNames:MES-NpcThrusters-Hydro]
                [ConfigureSpecialNpcThrusters:true]
                [NpcHydroThrustPowerMultiply:0.01]
                [NpcHydroThrustForceMultiply:1.5]

                [RestrictNpcHydroThrust:true]
            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Manipulation_Atmo</SubtypeId>
            </Id>
            <Description>
                [MES Manipulation]

                [UseBlockReplacerProfile:true]
                [BlockReplacerProfileNames:MES-NpcThrusters-Atmo]
                [ConfigureSpecialNpcThrusters:true]
                [NpcAtmoThrustPowerMultiply:0.01]
                [NpcAtmoThrustForceMultiply:10]

                [RestrictNpcAtmoThrust:true]
            </Description>
        </EntityComponent>

    </EntityComponents>
</Definitions>