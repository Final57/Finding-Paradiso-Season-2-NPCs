<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <SpawnGroups>
    <SpawnGroup>
      <Id>
        <TypeId>SpawnGroupDefinition</TypeId>
        <SubtypeId>PAR_VALK_FASP-A_Escort_SpawnGroup</SubtypeId>
      </Id>
      <Description>
        [Modular Encounters SpawnGroup]

        [UseRivalAi:true]
        [RivalAiReplaceRemoteControl:true]
        [ReplenishSystems:true]
        [ReplenishProfiles:PAR_VALK_Replenishment_Light_Guns]

        [SpawnConditionsProfiles:PAR_VALK_FASP-A_Escort_SpawnConditions]

        [UseRandomNameGenerator:true]
        [RenameGrid:true]
        [RandomGridNamePattern:Expedition Force CAP Escort RandomChar-RandomNumber]
        [ProcessBlocksForCustomGridName:true]

        [ManipulationProfiles:PAR_VALK_Manipulation]
        [ManipulationProfiles:PAR_VALK_Manipulation_Fighter]
        [ManipulationProfiles:PAR_VALK_Manipulation_Atmo]
        [ManipulationProfiles:MSB_Manipulation_WearAndTear_Light_Chance]

      </Description>
      <Icon>Textures\GUI\Icons\Fake.dds</Icon>
      <IsPirate>true</IsPirate>
      <Frequency>5.0</Frequency>
      <Prefabs>
        <Prefab SubtypeId="[MES-VALK]Valkoran FASP-A Class">
          <Position>
            <X>0</X>
            <Y>0</Y>
            <Z>0</Z>
          </Position>
          <Speed>75</Speed>
          <Behaviour>PAR_VALK_FASP_Escort_Behavior</Behaviour>
        </Prefab>
      </Prefabs>
    </SpawnGroup>
  </SpawnGroups>

  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>PAR_VALK_FASP-A_Escort_SpawnConditions</SubtypeId>
      </Id>
      <Description>
        [MES Spawn Conditions]

        [RivalAiAnySpawn:true]
        [FactionOwner:VALK]

        [SkipGridSpawnChecks:true]
        [IgnoreCombatPhase:true]
        [SkipAirDensityCheck:true]

        [AtmosphericCargoShip:true]
        [GravityCargoShip:false]
        [SpaceCargoShip:false]
        [LunarCargoShip:false]
      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>
