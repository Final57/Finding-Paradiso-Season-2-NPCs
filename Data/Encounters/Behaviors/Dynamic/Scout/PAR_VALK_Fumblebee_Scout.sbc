<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <SpawnGroups>

        <SpawnGroup>
            <Id>
                <TypeId>SpawnGroupDefinition</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Spawngroup</SubtypeId>
            </Id>
            <Description>
                [Modular Encounters SpawnGroup]

                [UseRivalAi:true]
                [RivalAiReplaceRemoteControl:true]

                [SpawnConditionsProfiles:PAR_VALK_Fumblebee_Scout_SpawnConditions]

                [ManipulationProfiles:PAR_VALK_Manipulation]
                [ManipulationProfiles:PAR_VALK_Manipulation_Fighter]
                [ManipulationProfiles:PAR_VALK_Manipulation_Atmo]

                [ManipulationProfiles:MSB_Manipulation_WearAndTear_Light_Chance]

                [ReplenishSystems:true]

                [UseRandomNameGenerator:true]
                [ProcessBlocksForCustomGridName:true]
                [RandomGridNamePattern:Scout RandomLetterRandomNumberRandomLetter-RandomNumberRandomNumber]
            </Description>
            <Icon>Textures\GUI\Icons\Fake.dds</Icon>
            <IsPirate>true</IsPirate>
            <Frequency>5.0</Frequency>
            <Prefabs>
                <Prefab SubtypeId="[MES-VALK]Valkoran Fumblebee Class">
                    <Position>
                        <X>0.0</X>
                        <Y>0.0</Y>
                        <Z>0.0</Z>
                    </Position>
                    <Speed>50</Speed>
                    <Behaviour>PAR_VALK_Fumblebee_Scout_Behavior</Behaviour>
                </Prefab>
            </Prefabs>
        </SpawnGroup>

    </SpawnGroups>
    <EntityComponents>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_SpawnConditions</SubtypeId>
            </Id>
            <Description>
                [MES Spawn Conditions]

                [AtmosphericCargoShip:true]

                [RivalAiAnySpawn:true]
                [FactionOwner:VALK]

                [IgnoreCombatPhase:true]
                [SkipAirDensityCheck:true]

                [AtmosphericCargoShipChance:70]

                [UseKnownPlayerLocations:true]
                [KnownPlayerLocationMustMatchFaction:true]
                [KnownPlayerLocationMustBeInside:false]
            </Description>
            <Icon>Textures\GUI\Icons\Fake.dds</Icon>
            <SizeX>1</SizeX>
            <SizeY>1</SizeY>
            <SizeZ>1</SizeZ>
            <CanStack>true</CanStack>
            <PhysicalContent>false</PhysicalContent>
        </EntityComponent>
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Behavior</SubtypeId>
            </Id>
            <Description>
                [RivalAI Behavior]

                [BehaviorName:CargoShip]
                [TargetData:MSB_TargetProfile_LowRange]
                [OverrideTargetData:MSB_TargetProfile_LongRange]
                [AutopilotData:MSB_Scout_Autopilot]
                [SecondaryAutopilotData:PAR_VALK_Autopilot_Helicopter]

                [DialogueBanks:PAR_VALK_DialogueBank_Dynamic.xml]

                [UsePlayerDistanceTimer:true]
                [PlayerDistanceTrigger:5000] 
                [PlayerDistanceTimerTrigger:3000]

                [Triggers:PAR_VALK_Fumblebee_Scout_Trigger_SpawnGravityRelay]
                [Triggers:PAR_VALK_Fumblebee_Scout_Trigger_SpawnSetup]

                [TriggerGroups:MSB_System_Dialogue_TriggerGroup_Dynamic]

                [TriggerGroups:MSB_DynamicCommon_TriggerGroup]
                [TriggerGroups:MSB_System_Communication_TriggerGroup]

                [TriggerGroups:MSB_Gunship_TriggerGroup]
                [TriggerGroups:MSB_Scout_TriggerGroup]
                [TriggerGroups:MSB_System_Despawn_TriggerGroup_Simple]
            </Description>
        </EntityComponent>


        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Trigger_SpawnSetup</SubtypeId>
            </Id>
            <Description>
                [RivalAI Trigger]

                [Type:Timer]

                [UseTrigger:true]
                [StartsReady:true]

                [MaxActions:1]
                [Actions:PAR_VALK_Fumblebee_Scout_Action_SpawnSetup]
            </Description>
        </EntityComponent>
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Action_SpawnSetup</SubtypeId>
            </Id>
            <Description>
                [RivalAI Action]

                [ChangeAntennaRanges:true]
                [AntennaRangeChangeAmount:15000]
                [AntennaNamesForRangeChange:]
            </Description>
        </EntityComponent>
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Trigger_SpawnGravityRelay</SubtypeId>
            </Id>
            <Description>
                [RivalAI Trigger]

                [Type:Manual]
                [Tags:MSB_TriggerEvent_Scout_SpawnRelay_Gravity]

                [UseTrigger:true]
                [StartsReady:true]

                [MaxActions:1]
                [Actions:PAR_VALK_Fumblebee_Scout_Action_SpawnGravityRelay]
            </Description>
        </EntityComponent>
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Action_SpawnGravityRelay</SubtypeId>
            </Id>
            <Description>
                [RivalAI Action]

                [SpawnEncounter:true]
                [Spawner:PAR_VALK_Fumblebee_Scout_Spawn_SpawnGravityRelay]
            </Description>
        </EntityComponent>
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Spawn_SpawnGravityRelay</SubtypeId>
            </Id>
            <Description>
                [RivalAI Spawn]

                [UseSpawn:true]
                [StartsReady:true]

                [SpawningType:PlanetaryInstallation]
                [UseRelativeSpawnPosition:false]
                [IgnoreSafetyChecks:false]

                [MaxSpawns:1]
                [SpawnGroups:PAR_VALK_Outpost_Static_SpawnGroup]

                [MinDistance:5000]
                [MaxDistance:10000]

                [MinAltitude:0]
                [MaxAltitude:1]
            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK_Fumblebee_Scout_Trigger_PlaceCrew</SubtypeId>
            </Id>
            <Description>
                [RivalAI Trigger]

                [Type:PlayerNear]

                [UseTrigger:true]
                [StartsReady:true]

                [TargetDistance:1000]

                [MinCooldownMs:5000]
                [MaxCooldownMs:5001]

                [MaxActions:1]
                [Actions:PAR_VALK__Scout_Action_PlaceCrew]
            </Description>
        </EntityComponent>
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>PAR_VALK__Scout_Action_PlaceCrew</SubtypeId>
            </Id>
            <Description>
                [RivalAI Action]

                [AddBotsToGrid:true]
                [BotCount:1]

                [OnlySpawnBotsInPressurizedRooms:true]

                [BotSpawnProfileNames:PAR_VALK_BotProfile_Crew]
            </Description>
        </EntityComponent>

    </EntityComponents>
</Definitions>
