  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
        <Id>
            <TypeId>Inventory</TypeId>
            <SubtypeId>PAR_PMG_Container_Static_SpawnConditions</SubtypeId>
        </Id>
        <Description>
            [MES Spawn Conditions]

            [RivalAiSpawn:true]
            [RivalAiAnySpawn:true]

            [FactionOwner:PMG]
            [ForceStaticGrid:true]

            [PrefabSpawningMode:Random]
        </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
        <Id>
            <TypeId>Inventory</TypeId>
            <SubtypeId>PAR_PMG_Container_Static_SpawnConditions_Planetary</SubtypeId>
        </Id>
        <Description>
            [MES Spawn Conditions]
    
            [PlanetaryInstallation:true]
            [PlanetaryInstallationChance:15]
            [PlanetaryInstallationType:Small]

            [PrefabSpawningMode:Random]

            [FactionOwner:PMG]
        </Description>
    </EntityComponent>

   <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
