<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <SpawnGroups>

    <SpawnGroup>
        <Id>
            <TypeId>SpawnGroupDefinition</TypeId>
            <SubtypeId>PAR_PMG_Container_Static_SpawnGroup</SubtypeId>
        </Id>
        <Description>
            [Modular Encounters SpawnGroup]

            [UseRivalAi:true]
            [RivalAiReplaceRemoteControl:true]
            [ReplenishSystems:true]

            [SpawnConditionsProfiles:PAR_PMG_Container_Static_SpawnConditions]
            [SpawnConditionsProfiles:PAR_PMG_Container_Static_SpawnConditions_Planetary]
            [UseFirstConditionsAsPersistent:True]
            
            [ManipulationProfiles:PAR_PMG_Manipulation]

            [ManipulationProfiles:MSB_Manipulation_WearAndTear_Heavy_Chance]

            [UseRandomNameGenerator:true]
            [RandomGridNamePattern:Container RandomNumberRandomNumberRandomNumber-RandomLetterRandomLetterRandomNumber]
            [ProcessBlocksForCustomGridName:true]
        </Description>
        <Icon>Textures\GUI\Icons\Fake.dds</Icon>
        <IsPirate>true</IsPirate>
        <Frequency>5.0</Frequency>
        <Prefabs>
            <Prefab SubtypeId="[MES-PMG] Containers A">
                <Position>
                    <X>0.0</X>
                    <Y>1.2</Y>
                    <Z>0.0</Z>
                </Position>
                <Speed>0</Speed>
                <Behaviour>PAR_PMG_Container_Static_Behavior</Behaviour>
            </Prefab>
            <Prefab SubtypeId="[MES-PMG] Containers B">
